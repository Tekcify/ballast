<UserControl x:Class="Ballast.UI.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Ballast.UI">
    <StackPanel>
        <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="MEMORY" Style="{StaticResource T.Section}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{Binding PressureBrush}" VerticalAlignment="Center" Margin="0,1,6,0" />
                <TextBlock x:Name="StatusLabel" Text="{Binding PressureLabel}" Style="{StaticResource T.Caption}" />
            </StackPanel>
        </DockPanel>

        <StackPanel Visibility="{Binding HasMemory, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding UsedText}" Style="{StaticResource T.Display}" />
                <TextBlock Text="{Binding OfText}" Style="{StaticResource T.Body}" VerticalAlignment="Bottom" Margin="8,0,0,8" />
            </StackPanel>

            <ui:MeterBar Height="8" Margin="0,10,0,0" Segments="{Binding Segments}" Track="{DynamicResource Track}" />

            <ItemsControl ItemsSource="{Binding Legend}" Margin="0,10,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Ellipse Width="6" Height="6" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,1,7,0" />
                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Caption}" FontSize="12" />
                            <TextBlock Text="{Binding Value}" Style="{StaticResource T.Number}" FontSize="12" Margin="6,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding CommitText}" Style="{StaticResource T.Caption}" Margin="0,8,0,0" />
        </StackPanel>

        <TextBlock Text="Checking the vibes…" Style="{StaticResource T.Body}" Margin="0,8,0,0"
                   Visibility="{Binding HasMemory, Converter={StaticResource Hidden}}" />

        <StackPanel Visibility="{Binding HasAdvice, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource Hairline}" />
            <TextBlock Text="THE MOVE" Style="{StaticResource T.Section}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Advice}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding SeverityBrush}" CornerRadius="1" Margin="0,1" />
                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                <TextBlock Text="{Binding Headline}" Style="{StaticResource T.Row}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Body}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource B.Quiet}" VerticalAlignment="Top"
                                    Content="{Binding ActionText}" Foreground="{Binding ActionBrush}" Background="{Binding ActionFill}"
                                    Command="{Binding Act}" Visibility="{Binding HasAction, Converter={StaticResource Visible}}"
                                    AutomationProperties.Name="{Binding ActionText}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock Text="{Binding QuitStatus}" Style="{StaticResource T.Caption}" Margin="0,2,0,0"
                   Visibility="{Binding QuitStatus, Converter={StaticResource Visible}}" />

        <Border Style="{StaticResource Hairline}" />
        <DockPanel LastChildFill="False" Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Left" Text="WHO'S EATING RAM" Style="{StaticResource T.Section}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding ListedText}" Style="{StaticResource T.Caption}" />
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Row" CornerRadius="6" Padding="6,5" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="54" />
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource Fill}" VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Row}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Caption}" Margin="0,1,0,0"
                                           Visibility="{Binding Subtitle, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding CpuText}" Foreground="{Binding CpuBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       Visibility="{Binding ShowCpu, Converter={StaticResource Visible}}" />
                            <TextBlock Grid.Column="3" Text="{Binding MemoryText}" Style="{StaticResource T.Number}" VerticalAlignment="Center" />
                            <TextBlock x:Name="Tag" Grid.Column="4" Text="system" Style="{StaticResource T.Faint}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Visibility="{Binding IsSystem, Converter={StaticResource Visible}}" />
                            <Button x:Name="QuitButton" Grid.Column="4" Content="Quit" Style="{StaticResource B.Quiet}"
                                    Foreground="#FFD0554B" Background="#24D0554B" HorizontalAlignment="Right"
                                    Command="{Binding Quit}" Visibility="Collapsed"
                                    AutomationProperties.Name="{Binding Name, StringFormat=Quit {0}}" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Fill}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                                <Condition Binding="{Binding CanQuit}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="QuitButton" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=Row}" Value="True" />
                                <Condition Binding="{Binding CanQuit}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="QuitButton" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
