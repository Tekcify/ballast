<Window x:Class="Ballast.UI.HeadsUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ballast heads-up"
        Width="372"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="-20000"
        Top="-20000"
        Background="{DynamicResource Bg}"
        BorderBrush="{DynamicResource Stroke}"
        BorderThickness="1"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="16,14,16,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="15" Background="{Binding AccentFill}" VerticalAlignment="Top">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                <TextBlock Text="{Binding Headline}" Style="{StaticResource T.Row}" FontSize="14" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Body}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource B.Icon}" Content="&#xE711;" Click="OnDismiss" VerticalAlignment="Top"
                    ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Foreground="{DynamicResource Ink2}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Suggestions}" Margin="42,10,0,0" Focusable="False"
                      Visibility="{Binding HasSuggestions, Converter={StaticResource Visible}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Row}" FontWeight="Normal" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource T.Number}" VerticalAlignment="Center" Margin="8,0,10,0" />
                        <Button Grid.Column="2" Content="Quit" Style="{StaticResource B.Quiet}" Foreground="#FFD0554B" Background="#24D0554B"
                                Command="{Binding Quit}" AutomationProperties.Name="{Binding Name, StringFormat=Quit {0}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="42,8,0,0" Visibility="{Binding IsAlert, Converter={StaticResource Visible}}">
            <Button Content="Open Ballast" Style="{StaticResource B.Quiet}" Foreground="{DynamicResource Ink}" Click="OnOpen" />
            <Button Content="Storage" Style="{StaticResource B.Quiet}" Click="OnStorage" Margin="6,0,0,0" />
            <Button Content="Snooze 1h" Style="{StaticResource B.Quiet}" Click="OnSnooze" Margin="6,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
