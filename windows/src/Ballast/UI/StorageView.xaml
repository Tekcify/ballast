<UserControl x:Class="Ballast.UI.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Ballast.UI">
    <StackPanel>
        <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="STORAGE" Style="{StaticResource T.Section}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="{Binding ScanButtonText}" Command="{Binding Scan}"
                    Style="{StaticResource B.Quiet}" Foreground="#FF7C8AF0" Background="#245B6CD6" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="{Binding PickedText}" Style="{StaticResource T.Display}" />
            <TextBlock Text="{Binding FoundText}" Style="{StaticResource T.Body}" VerticalAlignment="Bottom" Margin="8,0,0,8" />
        </StackPanel>

        <ui:MeterBar Height="8" Margin="0,10,0,0" Segments="{Binding DiskSegments}" Track="{DynamicResource Track}" />
        <TextBlock Text="{Binding DiskText}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" />

        <CheckBox Style="{StaticResource C.Switch}" Margin="0,12,0,0" IsChecked="{Binding IncludeDependencies}"
                  IsEnabled="{Binding IsBusy, Converter={x:Static ui:Not.Instance}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Also measure node_modules" Foreground="{DynamicResource Ink}" />
                <TextBlock Text="slow" Style="{StaticResource T.Faint}" Margin="7,1,0,0" />
            </StackPanel>
        </CheckBox>

        <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Body}" Margin="0,10,0,0" />
        <TextBlock Text="{Binding ResultText}" Style="{StaticResource T.Body}" Foreground="#FF6FAE84" Margin="0,4,0,0"
                   Visibility="{Binding ResultText, Converter={StaticResource Visible}}" />

        <StackPanel Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource Hairline}" />
            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                <Border DockPanel.Dock="Left" Style="{StaticResource SegmentTrack}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource R.Segment}" Content="Biggest" GroupName="Sort"
                                     IsChecked="{Binding SortBySize}" />
                        <RadioButton Style="{StaticResource R.Segment}" Content="By type" GroupName="Sort"
                                     IsChecked="{Binding SortBySize, Converter={x:Static ui:Not.Instance}}" />
                    </StackPanel>
                </Border>
                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearPicks}" Style="{StaticResource B.Quiet}" Margin="6,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Smart pick" Command="{Binding SmartPick}" Style="{StaticResource B.Quiet}"
                        Foreground="#FF6FAE84" Background="#24538E65" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource C.Pick}" IsChecked="{Binding IsPicked}" IsEnabled="{Binding IsSelectable}"
                                      VerticalAlignment="Top" Margin="2,1,12,0" AutomationProperties.Name="{Binding Title}"
                                      ToolTip="{Binding Path}" />
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Row}" MaxWidth="210" ToolTip="{Binding Path}" />
                                    <Border Background="{Binding RiskFill}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RiskLabel}" Foreground="{Binding RiskBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="Reason" Text="{Binding Reason}" Style="{StaticResource T.Body}" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding Meta}" Style="{StaticResource T.Faint}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Width="72">
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource T.Number}" HorizontalAlignment="Right" />
                                <ui:MeterBar Height="4" Margin="0,6,0,0" Segments="{Binding Bar}" Track="{DynamicResource Track}" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHeld}" Value="True">
                                <Setter TargetName="Reason" Property="Foreground" Value="#FFC67A2E" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding LeftAloneText}" Style="{StaticResource T.Body}" Margin="0,0,0,8"
                       Visibility="{Binding LeftAloneText, Converter={StaticResource Visible}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
