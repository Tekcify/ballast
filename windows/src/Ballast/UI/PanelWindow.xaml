<Window x:Class="Ballast.UI.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ballast"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="-20000"
        Top="-20000"
        Background="{DynamicResource Bg}"
        BorderBrush="{DynamicResource Stroke}"
        BorderThickness="1"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <Grid DockPanel.Dock="Bottom" Margin="10,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="MemoryTab" Style="{StaticResource R.Tab}" GroupName="Pane" Content="Memory" Checked="OnTab" />
                <RadioButton x:Name="StorageTab" Style="{StaticResource R.Tab}" GroupName="Pane" Content="Storage" Checked="OnTab" Margin="2,0" />
                <RadioButton x:Name="SettingsTab" Style="{StaticResource R.Tab}" GroupName="Pane" Content="Settings" Checked="OnTab" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding LastSampledText}" Style="{StaticResource T.Faint}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Grid.Column="3" Style="{StaticResource B.Icon}" Content="&#xE7E8;" Click="OnQuit"
                    ToolTip="Quit Ballast" AutomationProperties.Name="Quit Ballast" Foreground="{DynamicResource Ink2}" />
        </Grid>
        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Hairline}" />
        <ScrollViewer x:Name="Scroller" MaxHeight="600" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ContentControl x:Name="Host" Margin="18,16,18,10" Focusable="False" />
        </ScrollViewer>
    </DockPanel>
</Window>
